{
	"name": "@crutchcrew/uikit",
	"version": "0.0.1",
	"description": "React component library and design system, built on Base UI and Tailwind CSS",
	"keywords": [
		"components",
		"design-system",
		"react",
		"tailwindcss",
		"ui"
	],
	"homepage": "https://github.com/crutchcrew/uikit#readme",
	"bugs": {
		"url": "https://github.com/crutchcrew/uikit/issues"
	},
	"license": "MIT",
	"author": "Crutch Crew",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/crutchcrew/uikit.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"exports": {
		"./theme.css": "./src/theme.css",
		"./components": {
			"types": "./dist/components/index.d.ts",
			"import": "./dist/components/index.js"
		},
		"./blocks": {
			"types": "./dist/blocks/index.d.ts",
			"import": "./dist/blocks/index.js"
		},
		"./provider": {
			"types": "./dist/provider.d.ts",
			"import": "./dist/provider.js"
		}
	},
	"scripts": {
		"build": "bun run --parallel build:compile build:declaration",
		"build:compile": "bun build src/components/index.ts src/blocks/index.ts src/provider.tsx --outdir dist --format esm",
		"build:declaration": "tsc -p tsconfig.build.json --noEmit false",
		"check": "bun run --parallel fmt:check lint lockfile:check",
		"dev": "ladle serve",
		"fmt": "oxfmt --write .",
		"fmt:check": "oxfmt --check .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lockfile:check": "bun install --frozen-lockfile",
		"prebuild": "rm -rf dist",
		"prepare": "lefthook install",
		"prepublishOnly": "bun run build",
		"story:build": "ladle build",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "1.39.0",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@ladle/react": "^5.1.1",
		"@tailwindcss/vite": "^4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@tsconfig/bases": "^1.0.27",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint-plugin-testing-library": "^7.16.2",
		"happy-dom": "^20.11.6",
		"lefthook": "^2.1.12",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"oxlint-tsgolint": ">=7.0.2001",
		"typescript": "^7.0.2",
		"vite": "^6.0.5",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"@types/react": "^19.2",
		"@types/react-dom": "^19.2",
		"react": "^19.2",
		"react-dom": "^19.2",
		"tailwindcss": "^4",
		"typescript": "^7.0"
	}
}
